# ============================================================
# CIPRIJAL — Activos TI — .gitignore
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/playwright-report
/test-results

# Next.js
/.next/
/out/
/build

# Environment variables — NUNCA comitear credenciales reales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.pem

# Vercel (si algún miembro del equipo usa Vercel localmente)
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma — NO ignorar migrations/ (deben estar en el repositorio)
/prisma/generated/

# Storage local de archivos adjuntos (solo aplica en desarrollo local)
/storage/

# IDE — solo settings locales, no el workspace compartido
.vscode/settings.json
.idea/
*.swp
*.swo

# Configuración auxiliar local de asistentes de desarrollo
/.claude/
