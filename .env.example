# =============================================================
# CIPRIJAL — Sistema de Gestión de Activos TI
# Variables de entorno — Copia este archivo como .env
# NUNCA comitear .env al repositorio
# =============================================================

# Base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:5432/nombre_bd
DATABASE_URL="postgresql://postgres:password@localhost:5432/ciprijal_activos"

# NextAuth.js v5 (beta)
# Nombre preferido en v5: AUTH_SECRET / AUTH_URL
# También acepta NEXTAUTH_SECRET / NEXTAUTH_URL por compatibilidad
# Genera el secreto con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
AUTH_URL="http://localhost:3000"

# Entorno
NODE_ENV="development"

# Seed — usuario administrador inicial
# Usados únicamente por prisma/seed.ts al ejecutar: npm run db:seed
# No usar valores reales aquí; configúralos en .env antes del primer seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# -------------------------------------------------------------
# Variables NO implementadas en v1.0 — reservadas para sprints futuros
# -------------------------------------------------------------
# SMTP_HOST="smtp.ejemplo.com"
# SMTP_PORT="587"
# SMTP_USER="notificaciones@ciprijal.com"
# SMTP_PASS="contraseña-smtp"
# SMTP_FROM="CIPRIJAL TI <notificaciones@ciprijal.com>"
#
# STORAGE_PATH="./storage/uploads"
