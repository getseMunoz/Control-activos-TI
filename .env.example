# =============================================================
# CIPRIJAL — Sistema de Gestión de Activos TI
# Variables de entorno — Copia este archivo como .env.local
# NUNCA comitear .env.local al repositorio
# =============================================================

# Base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:5432/nombre_bd
DATABASE_URL="postgresql://postgres:password@localhost:5432/ciprijal_activos"

# NextAuth.js
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Email (SMTP) — Para alertas y notificaciones
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@ciprijal.com"
SMTP_PASS="contraseña-smtp"
SMTP_FROM="CIPRIJAL TI <notificaciones@ciprijal.com>"

# Almacenamiento de archivos adjuntos (ruta local en el servidor)
STORAGE_PATH="./storage/uploads"

# Entorno (development | staging | production)
NODE_ENV="development"

# Seed — usuario administrador inicial
# Usados únicamente por prisma/seed.ts. No usar contraseñas reales aquí.
SEED_ADMIN_EMAIL="admin@ciprijal.com"
SEED_ADMIN_PASSWORD="Cambia.Esta.Clave.2024"
